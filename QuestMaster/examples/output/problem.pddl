;; The Quest for Crystal Caverns - generated by QuestMaster
(define (problem quest-problem)
  (:domain quest-domain)
  (:objects
    hero - agent
    mistveil_hollow - location  ; Mistveil Hollow
    sagebrush_ridge - location  ; Sagebrush Ridge
    whispering_woods - location  ; Whispering Woods
    frostbite_falls - location  ; Frostbite Falls
    crystal_caverns - location  ; Crystal Caverns
    midnight_meadow - location  ; Midnight Meadow
    raven_s_peak - location  ; Raven's Peak
    banshee_s_bend - location  ; Banshee's Bend
    glimmerglen - location  ; Glimmerglen
    barren_barrow - location  ; Barren Barrow
    luminous_lake - location  ; Luminous Lake
    flame_of_eternity - item  ; Flame of Eternity
    golem - obstacle  ; golem
  )
  (:init
    ;; the hero sets out
    (at hero mistveil_hollow)
    (= (total-cost) 0)
    ;; places that can be entered freely (guarded ones open once their guardian falls)
    (clear mistveil_hollow)
    (clear sagebrush_ridge)
    (clear whispering_woods)
    (clear frostbite_falls)
    (clear midnight_meadow)
    (clear raven_s_peak)
    (clear banshee_s_bend)
    (clear glimmerglen)
    (clear barren_barrow)
    (clear luminous_lake)
    ;; the roads of the realm
    (connected mistveil_hollow sagebrush_ridge)
    (connected sagebrush_ridge mistveil_hollow)
    (connected mistveil_hollow midnight_meadow)
    (connected midnight_meadow mistveil_hollow)
    (connected mistveil_hollow raven_s_peak)
    (connected raven_s_peak mistveil_hollow)
    (connected sagebrush_ridge whispering_woods)
    (connected whispering_woods sagebrush_ridge)
    (connected sagebrush_ridge banshee_s_bend)
    (connected banshee_s_bend sagebrush_ridge)
    (connected whispering_woods frostbite_falls)
    (connected frostbite_falls whispering_woods)
    (connected whispering_woods glimmerglen)
    (connected glimmerglen whispering_woods)
    (connected frostbite_falls crystal_caverns)
    (connected crystal_caverns frostbite_falls)
    (connected frostbite_falls barren_barrow)
    (connected barren_barrow frostbite_falls)
    (connected frostbite_falls luminous_lake)
    (connected luminous_lake frostbite_falls)
    ;; hidden treasures
    (item_at flame_of_eternity raven_s_peak)
    ;; guardians and their weaknesses
    (guarded_by crystal_caverns golem)
    (defeats flame_of_eternity golem)
  )
  (:goal (and
    (at hero crystal_caverns)
    (has hero flame_of_eternity)
    (defeated golem)
  ))
  (:metric minimize (total-cost))
)